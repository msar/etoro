    "import:etrade": "tsx scripts/verify-etrade.ts --import"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"

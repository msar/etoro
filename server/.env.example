# Optional: port only. Prefer the in-app login / broker connect screens to store
# credentials in server/data/credentials.json (gitignored). Env vars still work as overrides.
PORT=4000

# History backend: local (default, SQLite in server/data/history.sqlite) or supabase
# HISTORY_BACKEND=local

# Optional env overrides (leave blank if using the in-app UI):

#!/usr/bin/env bash
# Portfolio Evolution.app entry point — hands off to bootstrap (self-updating).
set -euo pipefail

CONTENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RESOURCES_DIR="$CONTENTS_DIR/Resources"
SUPPORT_DIR="${PE_SUPPORT_DIR:-$HOME/Library/Application Support/Portfolio Evolution}"
APP_BOOTSTRAP="$SUPPORT_DIR/app/scripts/bootstrap-macos.sh"
BUNDLED_BOOTSTRAP="$RESOURCES_DIR/bootstrap-macos.sh"

export PE_SUPPORT_DIR="$SUPPORT_DIR"

alert() {
  local msg="$1"
  local q="${msg//\\/\\\\}"
  q="${q//\"/\\\"}"
  osascript -e "display alert \"Portfolio Evolution\" message \"$q\" as critical" 2>/dev/null || printf 'ERROR: %s\n' "$msg" >&2
}

# Prefer the in-app bootstrap (updated from GitHub). Fall back to the copy
# bundled inside this .app for first launch before any download.
if [[ -x "$APP_BOOTSTRAP" ]]; then
  exec "$APP_BOOTSTRAP"
fi

if [[ -x "$BUNDLED_BOOTSTRAP" ]]; then
  exec "$BUNDLED_BOOTSTRAP"
fi

alert "Could not find the bootstrap script inside this app.\n\nRe-download Portfolio Evolution.app and try again."
exit 1
